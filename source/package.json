{
  "name": "iaq-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/sitemap.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "build:file": "vite build --config vite.config.file.js && node scripts_build_file.mjs",
